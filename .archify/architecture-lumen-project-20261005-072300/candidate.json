  "cards": [
    {
      "dot": "rose",
      "title": "Authentication flow",
      "items": [
        "Sign-up hashes the password, creates a workspace and admin membership, then returns access and refresh tokens.",
        "The frontend stores both tokens in localStorage; bearer access tokens protect /auth/me and refresh rotates the opaque token.",
        "PostgreSQL stores password hashes and refresh-token hashes; membership dependencies enforce workspace access and admin checks."
      ]
    },
    {
      "dot": "amber",
      "title": "RAG: data model exists, runtime is not wired",
      "items": [
        "The schema enables pgvector and defines workspace-scoped documents and chunks, 1024-dimensional embeddings, HNSW vector and full-text indexes, plus conversation/message tables.",
        "FastAPI currently registers only auth and workspace routers; no document-ingestion, embedding, retrieval, or answer-generation route/service is present.",
        "The dashboard shows sample documents and a disabled chat/upload preview, not a live RAG path."
      ]
    }
  ]
